      "patch": "@@ -0,0 +1,11 @@\n+import { definePluginApp } from \"@get-bb/plugin-sdk/app\";\n+import { PrTab } from \"./ui/pr-tab\";\n+\n+export default definePluginApp((app) => {\n+  app.slots.threadPanelAction({\n+    id: \"pr\",\n+    title: \"PR\",\n+    layout: \"padded\",\n+    component: PrTab,\n+  });\n+});"
