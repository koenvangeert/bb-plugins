      "status": "added",
      "additions": 21,
      "deletions": 0,
      "changes": 21,
      "blob_url": "https://github.com/koenvangeert/bb-plugins/blob/3d94a5d4ddf1640c52f359f359a68ccf9fc1cf70/plugins%2Fgithub-insight%2Fcore%2Fpr-ref.ts",
      "raw_url": "https://github.com/koenvangeert/bb-plugins/raw/3d94a5d4ddf1640c52f359f359a68ccf9fc1cf70/plugins%2Fgithub-insight%2Fcore%2Fpr-ref.ts",
      "contents_url": "https://api.github.com/repos/koenvangeert/bb-plugins/contents/plugins%2Fgithub-insight%2Fcore%2Fpr-ref.ts?ref=3d94a5d4ddf1640c52f359f359a68ccf9fc1cf70",
      "patch": "@@ -0,0 +1,21 @@\n+export interface PullRequestRef {\n+  owner: string;\n+  repo: string;\n+  number: number;\n+}\n+\n+const PR_PATH = /^\\/([^/]+)\\/([^/]+)\\/pull\\/(\\d+)\\/?$/;\n+\n+export function parsePullRequestUrl(url: string): PullRequestRef | null {\n+  let parsed: URL;\n+  try {\n+    parsed = new URL(url);\n+  } catch {\n+    return null;\n+  }\n+  if (parsed.hostname !== \"github.com\") return null;\n+  const match = PR_PATH.exec(parsed.pathname);\n+  if (match === null) return null;\n+  const [, owner, repo, number] = match;\n+  return { owner: owner!, repo: repo!, number: Number(number) };\n+}"
    },
